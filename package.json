{
  "name": "@xelis/xswd-connect",
  "version": "0.1.2",
  "description": "JavaScript library for XSWD relayed connections - connect web dApps to mobile wallets via QR code with end-to-end encryption",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepare": "npm run build",  
    "prepublishOnly": "npm run build"
  },
  "prepare": "npm run build",
  "keywords": [
    "xelis",
    "xswd",
    "wallet",
    "blockchain",
    "relay",
    "qrcode",
    "encryption"
  ],
  "author": "XELIS Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xelis-project/xswd-connect.git"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@xelis/sdk": "^0.10.3",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=16"
  }
}
